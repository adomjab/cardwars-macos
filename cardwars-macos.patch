-#endif
-#ifdef FRAGMENT
-uniform sampler2D _MainTex;
-uniform lowp vec4 _Color;
-varying highp vec2 xlv_TEXCOORD0;
-void main ()
-{
-  lowp vec4 tmpvar_1;
-  tmpvar_1 = (texture2D (_MainTex, xlv_TEXCOORD0) * _Color);
