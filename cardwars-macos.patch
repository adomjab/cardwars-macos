+++ b/Assets/Editor/MacBuild.cs
@@ -0,0 +1,57 @@
+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+
+// Builds a macOS .app of Card Wars.
+// From the editor: menu "Card Wars > Build macOS".
+// From the command line:
+//   Unity -batchmode -quit -projectPath <project> -executeMethod MacBuild.BuildMacOS [-buildOutput <path/CardWars.app>]
+public static class MacBuild
+{
+	private const string DefaultOutput = "Builds/macOS/CardWars.app";
+
+	[MenuItem("Card Wars/Build macOS")]
+	public static void BuildMacOS()
+	{
+		string output = GetArg("-buildOutput") ?? DefaultOutput;
+		Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(output)));
+
+		string[] scenes = EditorBuildSettings.scenes
+			.Where(s => s.enabled)
+			.Select(s => s.path)
+			.ToArray();
+
+		PlayerSettings.SetApplicationIdentifier(BuildTargetGroup.Standalone, "com.shishkabob.cardwars");
+		PlayerSettings.macRetinaSupport = true;
+		PlayerSettings.resizableWindow = true;
+
+		EditorUserBuildSettings.SwitchActiveBuildTarget(BuildTargetGroup.Standalone, BuildTarget.StandaloneOSX);
+
+		var report = BuildPipeline.BuildPlayer(scenes, output, BuildTarget.StandaloneOSX, BuildOptions.None);
+		if (!string.IsNullOrEmpty(report))
+		{
+			Debug.LogError("macOS build failed: " + report);
+			if (UnityEditorInternal.InternalEditorUtility.inBatchMode)
+			{
+				EditorApplication.Exit(1);
+			}
+			return;
+		}
+		Debug.Log("macOS build written to " + Path.GetFullPath(output));
+	}
+
+	private static string GetArg(string name)
+	{
+		string[] args = Environment.GetCommandLineArgs();
+		for (int i = 0; i < args.Length - 1; i++)
+		{
+			if (args[i] == name)
+			{
+				return args[i + 1];
+			}
+		}
+		return null;
+	}
+}
